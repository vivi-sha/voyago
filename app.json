{
  "expo": {
    "name": "Voyago",
    "slug": "voyago",
    "version": "1.0.0",
    "scheme": "voyago",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.panchamip.voyago"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Voyago to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Voyago to access your photos.",
          "cameraPermission": "Allow Voyago to access your camera."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b353070e-9713-46de-8b1e-3e5acc36cc5e"
      }
    }
  }
}
